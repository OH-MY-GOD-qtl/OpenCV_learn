{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p \"${workspaceFolder}/build/${relativeFileDirname}\" && /usr/bin/g++ -fdiagnostics-color=always -g -I\"${workspaceFolder}/includes\" \"${file}\" -o \"${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}\" $(pkg-config --cflags --libs opencv4)"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}